# VNIBB Environment Configuration
# Copy to .env and fill in your values

# Application
APP_NAME=VNIBB
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development  # development, staging, production

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (Supabase PostgreSQL)
# For local development with Docker:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vnibb

# For Supabase hosted (get from Supabase dashboard > Settings > Database):
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase API (optional, for direct Supabase client usage)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here  # For JWT validation (get from Supabase Settings > API)

# Redis Cache
# For local development with Docker:
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300  # Default TTL in seconds (5 minutes)

# VNStock Provider
VNSTOCK_API_KEY=your-api-key-here  # Golden Sponsor API key
VNSTOCK_SOURCE=VCI  # VCI or TCBS
VNSTOCK_TIMEOUT=30

# Scraper Settings
SCRAPER_ENABLED=true
SCRAPER_TIMEOUT=60
SCRAPER_MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO

# LLM Configuration (AI Copilot)
# Gemini (recommended - default)
GEMINI_API_KEY=your-gemini-api-key-here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# OpenAI (alternative)
# OPENAI_API_KEY=your-openai-api-key-here
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# Context7 MCP
CONTEXT7_API_KEY=your-context7-api-key-here
